# Mutable convenience default: override with an immutable digest for a
# reproducible guest, e.g. ZPU_SMOLVM_IMAGE=archlinux@sha256:...
image = "archlinux:base-devel"
cpus = 8
memory = 8192
net = true

# Deliberately absent: gpu=true. ZPU is built and executed in the guest; enabling
# SmolVM GPU would add virtio-gpu/Venus to a path whose isolation is the point.
