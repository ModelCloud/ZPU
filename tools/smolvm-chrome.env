#
# Reproduction config for: SmolVM -> Linux Desktop -> Chromium
# Source this from tools/smolvm-chrome.sh or export the variables before running.

# SmolVM machine that already has ZPU staged.
# Build/stage it first with:
#   tools/smolvm-zpu.sh create
#   tools/smolvm-zpu.sh bootstrap
#   tools/smolvm-zpu.sh build
#   tools/smolvm-zpu.sh package
#   tools/smolvm-zpu.sh stage
ZPU_SMOLVM_MACHINE=zpu-omarchy

# SmolVM 1.16.1 enables per-VM UID isolation.  Leave this at its safe default
# unless a controlled root-host bring-up requires the documented opt-out.
# ZPU_SMOLVM_UID_DROP=off

# Host X display used by the guest. The Smolfile mounts /tmp/.X11-unix/X0 into
# the guest, so only :0 is supported by the default launcher.
ZPU_DISPLAY=:0

# Start a minimal desktop (twm) on the host display before launching Chrome?
ZPU_START_DESKTOP=1

# Chromium binary inside the SmolVM guest. The Arch guest uses /usr/bin/chromium.
ZPU_CHROME_BIN=/usr/bin/chromium

# Page to render.
ZPU_CHROME_URL=https://www.google.com

# Where the guest writes the screenshot and where it is copied on the host.
# Relative paths are resolved from the repo root.
ZPU_GUEST_SCREENSHOT=/tmp/zpu-chrome.png
ZPU_HOST_SCREENSHOT=docs/assets/zpu-chromium-google.png

# 2K / 60 Hz profile. ZPU's Mosaic workers are restricted to exactly the two
# CPUs in ZPU_CHROME_CPU_SET; Chromium itself is not affinity-pinned.
ZPU_CHROME_WIDTH=2560
ZPU_CHROME_HEIGHT=1440
ZPU_CHROME_WAIT=10000
ZPU_CHROME_CPU_SET=0,1
ZPU_CHROME_REFRESH_HZ=60

# `tools/smolvm-chrome.sh benchmark` measures these real sites through CDP.
# A 17 ms p99 permits the same 2% scheduling margin used by the desktop 60 Hz
# gate while rejecting a missed 60 Hz compositor interval.
ZPU_CHROME_BENCHMARK_URLS=https://www.google.com,https://www.bing.com,https://www.youtube.com
ZPU_CHROME_BENCHMARK_DURATION=8
ZPU_CHROME_BENCHMARK_WARMUP=3
ZPU_CHROME_BENCHMARK_P99_MS=17

# Where tools/smolvm-desktop.sh writes the guest desktop capture.
ZPU_DESKTOP_SCREENSHOT=docs/assets/zpu-desktop.png
